# Neon pooled connection (host contains -pooler). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon direct connection (no -pooler). Used by Prisma migrations during the Vercel build.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"
# On Vercel, set this to the live site URL, for example https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# Optional — without these, OTPs are logged to the server console (dev mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ember & Oak <noreply@example.com>"
