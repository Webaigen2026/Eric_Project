# Neon pooled connection (host contains -pooler). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection (no -pooler). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional — without these, OTPs are logged to the server console (dev mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ember & Oak <noreply@example.com>"
